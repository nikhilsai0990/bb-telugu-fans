# ==============================================================================
# BB Telugu Fans - Production Environment Configuration Template (V1)
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://bbtelugufans.com

# PostgreSQL Database (Source of Truth)
DATABASE_URL=postgresql://bb_admin:SuperSecurePassword2026!@localhost:5432/bbtelugufans?schema=public
POSTGRES_USER=bb_admin
POSTGRES_PASSWORD=SuperSecurePassword2026!
POSTGRES_DB=bbtelugufans

# Redis (Caching & 50-IP Anti-Abuse Rate Limiting)
REDIS_URL=redis://:RedisSecurePassword2026!@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=RedisSecurePassword2026!

# Voting Security & IP Protection (Section 21)
MAX_VOTES_PER_IP=50
IP_HMAC_SALT=bb_telugu_fans_super_secure_salt_hmac_2026

# Authentication & Sessions (Section 25 & 26)
JWT_SECRET=bb_telugu_fans_jwt_signing_secret_key_minimum_64_characters_long_2026!
SESSION_SECRET=bb_telugu_fans_session_cookie_secret_key_2026!
COOKIE_DOMAIN=.bbtelugufans.com

# S3-Compatible Media Storage (Section 48)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_BUCKET=bb-telugu-fans-media
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_REGION=ap-south-1

# Cloudflare CDN, WAF & DDoS Protection (Section 5)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
